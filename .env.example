# RE5CertPro — environment variables template
# Copy this file to `.env` for local development, and paste the same
# values into Vercel's Project Settings → Environment Variables for
# deployment. `.env` is gitignored — never commit it.

# Supabase project (canonical: qdkkilaejttswlnzepzg).
# See docs/SUPABASE-PROJECT.md for the canonical/deprecated mapping.

VITE_SUPABASE_PROJECT_ID="qdkkilaejttswlnzepzg"
VITE_SUPABASE_URL="https://qdkkilaejttswlnzepzg.supabase.co"

# Anon (publishable) JWT — safe to ship in client bundles.
# Get the current value from:
#   https://app.supabase.com/project/qdkkilaejttswlnzepzg/settings/api
# under "anon" / "public".
VITE_SUPABASE_PUBLISHABLE_KEY="paste-anon-key-here"

# ─────────────────────────────────────────────────────────────────────
# NEVER put the SERVICE-ROLE key in this file or in Vercel env vars
# exposed to the client. It bypasses RLS. If you need server-side
# Supabase access from a Vercel function, set it as a server-side
# env var (no VITE_ prefix) on the function only.
# ─────────────────────────────────────────────────────────────────────
